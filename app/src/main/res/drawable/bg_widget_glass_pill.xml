<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_fill" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/widget_glass_top"
                android:centerColor="@color/widget_glass_center"
                android:endColor="@color/widget_glass_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_stroke" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
