<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- All layers share the widget bounds: no inset reduces the course area. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/widget_glass_top"
                android:centerColor="@color/widget_glass_center"
                android:endColor="@color/widget_glass_bottom" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_glass_edge" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
