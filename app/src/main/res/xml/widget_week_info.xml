<?xml version="1.0" encoding="utf-8"?>
<!-- 周视图整表卡片（WeekScheduleWidgetProvider，对齐 WakeUp ScheduleAppWidget）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.gfs.iyango.WidgetConfigActivity"
    android:description="@string/widget_week_description"
    android:initialLayout="@layout/widget_wakeup_classic_shell"
    android:previewImage="@drawable/widget_preview_card_week"
    android:previewLayout="@layout/widget_preview_holder_week"
    android:minHeight="250dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="4"
    android:updatePeriodMillis="10800000"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
