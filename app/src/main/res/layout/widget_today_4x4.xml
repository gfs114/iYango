<?xml version="1.0" encoding="utf-8"?>
<!-- 现代双列外壳（TodayLargeScheduleWidgetProvider，对齐 WakeUp today_list_app_widget：今天 | 明天）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_bg_pic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_round_rect"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/iv_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_round_rect"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:id="@+id/rl_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/header_buttons"
                android:orientation="vertical">

                <TextView
                    style="@style/WidgetTextHalo"
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_table_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_week_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/header_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    style="@style/WidgetTextHalo"
                    android:id="@+id/iv_adjust_style"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:contentDescription="组件设置"
                    android:src="@drawable/widget_ic_settings"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    style="@style/WidgetTextHalo"
                    android:id="@+id/widget_prev_day"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:contentDescription="前一天"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/WidgetTextHalo"
                    android:id="@+id/widget_today"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:contentDescription="回到今天"
                    android:gravity="center"
                    android:text="今"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />

                <TextView
                    style="@style/WidgetTextHalo"
                    android:id="@+id/widget_next_day"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:contentDescription="后一天"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 左列：选定日（今天） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_col_today_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="今天"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_col_today_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/lv_today"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@null"
                        android:dividerHeight="0dp" />

                    <LinearLayout
                        android:id="@android:id/empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/iv_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="64dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_empty_illustration"
                            android:visibility="gone" />

                        <TextView
                            style="@style/WidgetTextHalo"
                            android:id="@+id/tv_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 双列分割线 -->
            <ImageView
                android:id="@+id/iv_column_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="2dp"
                android:background="@color/widget_divider"
                android:contentDescription="@null" />

            <!-- 右列：次日（明天） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_col_next_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="明天"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/WidgetTextHalo"
                        android:id="@+id/tv_col_next_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="预告"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ListView
                        android:id="@+id/lv_next_day"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@null"
                        android:dividerHeight="0dp" />

                    <LinearLayout
                        android:id="@+id/empty_next_day"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/WidgetTextHalo"
                            android:id="@+id/tv_empty_next_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="(〃'▽'〃)\n明天没有课啦"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
